- var page_Title = 'General Widget';
- var height_equal          = true;
- var theme_customizer      = true;
- var date_picker           = true;
- var apex                  = true;
- var general_widget        = true;
- var sidebar               = true;
- var slick                 = true;
- var header_slider         = true;
- var counter               = true;
- var animate               = true;
- var scrollbar             = true;
doctype html
html(lang='en')
  include ../../components/header-files
  body
    include ../../components/loader
    include ../../components/taptop
    // page-wrapper Start
    #pageWrapper.page-wrapper.compact-wrapper
      include ../../components/header
      // Page Body Start
      .page-body-wrapper
        include ../../components/sidebar
        .page-body
          .container-fluid
            .page-title
              .row
                .col-sm-6
                  h3
                    | General
                .col-sm-6
                  ol.breadcrumb
                    li.breadcrumb-item
                      a(href='index.html')                                        
                        svg.stroke-icon
                          use(href='../assets/svg/icon-sprite.svg#stroke-home')
                    li.breadcrumb-item Widgets
                    li.breadcrumb-item.active General
          // Container-fluid starts
          .container-fluid
            .row.general-widget-wrapper 
              .col-xl-3
                .card.bg-light-primary.widget-card
                  .card-body   
                    .balance-wrapper
                      .balance-detail 
                        p New Customer
                        span 68
                      .customer-card.bg-light-primary 
                        svg.stroke-icon
                          use(href='../assets/svg/icon-sprite.svg#stroke-home')
                    .balance1 
                      p 10%
                        svg.stroke-icon
                          use(href='../assets/svg/icon-sprite.svg#up-arrow')
                      span | This month
              .col-xl-3
                .card.bg-light-secondary.widget-card
                  .card-body   
                    .balance-wrapper
                      .balance-detail 
                        p Running Orders
                        span 501
                      .customer-card.bg-light-secondary 
                        svg.stroke-icon.stroke-secondary
                          use(href='../assets/svg/icon-sprite.svg#stroke-home')
                    .balance1 
                      p.txt-secondary 10%
                        svg.stroke-icon.stroke-secondary
                          use(href='../assets/svg/icon-sprite.svg#up-arrow')
                      span | This month
              .col-xl-3
                .card.bg-light-success.widget-card
                  .card-body   
                    .balance-wrapper
                      .balance-detail 
                        p Total Profit
                        span $8.546
                      .customer-card.bg-light-success 
                        svg.stroke-icon.stroke-success
                          use(href='../assets/svg/icon-sprite.svg#stroke-home') 
                    .balance1 
                      p.txt-success 10%
                        svg.stroke-icon.stroke-success
                          use(href='../assets/svg/icon-sprite.svg#up-arrow')
                      span | This month
              .col-xl-3
                .card.bg-light-warning.widget-card
                  .card-body   
                    .balance-wrapper
                      .balance-detail 
                        p Order Completed
                        span 1400
                      .customer-card.bg-light-warning 
                        svg.stroke-icon.stroke-warning
                          use(href='../assets/svg/icon-sprite.svg#stroke-home')
                    .balance1 
                      p.txt-warning 10%
                        svg.stroke-icon.stroke-warning
                          use(href='../assets/svg/icon-sprite.svg#up-arrow')
                      span | This month
              .col-xl-4 
                .card 
                  .card-header 
                    .header-top 
                      h5 Top Countries By sale 
                  .card-body 
                    ul.top-country-sales-list
                      li
                        .d-flex.justify-content-between.align-items-center 
                          .sale-list
                            span
                              i.flag-icon.flag-icon-us
                            span.top-country-name France  
                          div   
                            i(data-feather="arrow-up-right" class="text-success")
                          div.sale-price 5,932
                      li
                        .d-flex.justify-content-between.align-items-center 
                          .sale-list
                            span
                              i.flag-icon.flag-icon-ae
                            span.top-country-name France  
                          div   
                            i(data-feather="arrow-down-right" class="text-danger")
                          div.sale-price 5,932
                      li
                        .d-flex.justify-content-between.align-items-center 
                          .sale-list
                            span
                              i.flag-icon.flag-icon-cn
                            span.top-country-name France  
                          div   
                            i(data-feather="arrow-down-right" class="text-danger")
                          div.sale-price 5,932
                      li
                        .d-flex.justify-content-between.align-items-center 
                          .sale-list
                            span
                              i.flag-icon.flag-icon-pt
                            span.top-country-name France  
                          div   
                            i(data-feather="arrow-up-right" class="text-success")
                          div.sale-price 5,932
                      li
                        .d-flex.justify-content-between.align-items-center 
                          .sale-list
                            span
                              i.flag-icon.flag-icon-fr
                            span.top-country-name France  
                          div   
                            i(data-feather="arrow-down-right" class="text-danger")
                          div.sale-price 5,932
                      li
                        .d-flex.justify-content-between.align-items-center 
                          .sale-list
                            span
                              i.flag-icon.flag-icon-es
                            span.top-country-name France  
                          div   
                            i(data-feather="arrow-up-right" class="text-success")
                          div.sale-price 5,932                  
              
                  
          // Container-fluid Ends
        include ../../components/footer
    include ../../components/footer-files
